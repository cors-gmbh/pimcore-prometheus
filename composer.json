{
    "name": "cors/prometheus",
    "type": "pimcore-bundle",
    "description": "CORS - Prometheus: expose Pimcore metrics to Prometheus",
    "keywords": [
        "cors",
        "pimcore",
        "prometheus",
        "metrics"
    ],
    "homepage": "https://www.cors.gmbh",
    "license": "MIT",
    "authors": [
        {
            "name": "CORS GmbH",
            "email": "office@cors.gmbh",
            "homepage": "https://www.cors.gmbh/",
            "role": "TEAM"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "pimcore/pimcore": "^2026.2",
        "coreshop/registry": "^2026.2",
        "promphp/prometheus_client_php": "^2.4"
    },
    "require-dev": {
        "coreshop/test-setup": "dev-main",
        "pimcore/opensearch-client": "^2026.1",
        "pimcore/studio-ui-bundle": "^2026.2",
        "symfony/dotenv": "^7.4",
        "symfony/runtime": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "CORS\\Bundle\\PrometheusBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "Kernel.php"
        ],
        "psr-4": {
            "App\\": "dev",
            "Pimcore\\Model\\DataObject\\": "var/classes/DataObject"
        }
    },
    "extra": {
        "pimcore": {
            "bundles": [
                "CORS\\Bundle\\PrometheusBundle\\CORSPrometheusBundle"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        }
    }
}
