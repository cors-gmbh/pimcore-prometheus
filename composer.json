{
    "name": "cors/prometheus",
    "type": "pimcore-bundle",
    "description": "CORS - Prometheus",
    "keywords": [
        "coreshop",
        "pimcore",
        "ecommerce"
    ],
    "homepage": "http://www.cors.gmbh",
    "license": "proprietary",
    "authors": [
        {
            "name": "CORS GmbH",
            "email": "office@cors.gmbh",
            "homepage": "https://www.cors.gmbh/",
            "role": "TEAM"
        }
    ],
    "require": {
        "php": ">=8.3",
        "pimcore/pimcore": "^11.0 || ^12.0",
        "coreshop/registry": "^2.2.9 || ^3.0 || ^4.0",
        "promphp/prometheus_client_php": "^2.4",
        "symfony/dotenv": "^6.4 || ^7.4"
    },
    "require-dev": {
        "cors/dev": "12.x-dev",
        "pimcore/admin-ui-classic-bundle": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CORS\\Bundle\\PrometheusBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "Kernel.php"
        ],
        "psr-4": {
            "Pimcore\\Model\\DataObject\\": "var/classes/DataObject"
        }
    },
    "repositories": {
        "packagist.org": false,
        "private-packagist": {
            "type": "composer",
            "url": "https://repo.packagist.com/cors/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-11": "11.0-dev"
        },
        "pimcore": {
            "bundles": [
                "CORS\\Bundle\\PrometheusBundle\\CORSPrometheusBundle"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
